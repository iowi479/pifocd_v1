config *.deviceSink1.app[2].io.localPort 1003
config *.deviceSink1.app[3].io.localPort 1004
config *.deviceSink1.app[0].io.displayStringTextFormat "\"{numReceived} Stream-(7)-(0)\""
config *.deviceSink1.app[1].io.displayStringTextFormat "\"{numReceived} Stream-(6)-(1)\""
