config debug-on-errors true
config image-path ../../inet-4.6.0/images
config network DumbbellNetwork
config sim-time-limit 10s
config **.cmdenv-log-level info
config *.*.eth[*].bitrate 100Mbps
config *.deviceSource*.numApps 1
config *.deviceSource*.app[0].typename UdpSourceApp
config *.deviceSource1.app[0].display-name Source1
config *.deviceSource2.app[0].display-name Source2
config *.deviceSource1.app[0].io.destAddress "\"deviceSink1\""
config *.deviceSource2.app[0].io.destAddress "\"deviceSink2\""
config *.deviceSource1.app[0].io.destPort 1000
config *.deviceSource2.app[0].io.destPort 1001
config *.deviceSource1.app[0].io.displayStringTextFormat "\"{numSent} Stream1\""
config *.deviceSource2.app[0].io.displayStringTextFormat "\"{numSent} Stream2\""
config *.deviceSource*.app[0].source.packetLength "1000B - 46B"
config *.deviceSource1.app[0].source.productionInterval "truncnormal(150us, 20us)"
config *.deviceSource2.app[0].source.productionInterval "truncnormal(200us, 20us)"
config *.deviceSink*.numApps 1
config *.deviceSink*.app[0].typename UdpSinkApp
config *.deviceSink1.app[0].display-name Sink1
config *.deviceSink2.app[0].display-name Sink2
config *.deviceSink1.app[0].io.localPort 1000
config *.deviceSink2.app[0].io.localPort 1001
config *.deviceSink1.app[0].io.displayStringTextFormat "\"{numReceived} Stream1\""
config *.deviceSink2.app[0].io.displayStringTextFormat "\"{numReceived} Stream2\""
config *.visualizer.infoVisualizer.displayInfos true
config *.visualizer.infoVisualizer.placementHint "\"top\""
config *.visualizer.infoVisualizer.modules "\"*.*.app[*].io\""
config *.visualizer.networkNodeVisualizer.annotationSpacing 12
config *.switch1.eth[2].macLayer.queue.typename SchedulingTreeQueue
config *.switch1.hasOutgoingStreams true
config *.switch1.bridging.streamIdentifier.identifier.mapping "[\n\t{stream: \"A0\", packetFilter: expr(udp.destPort == 1000)},\n\t{stream: \"B1\", packetFilter: expr(udp.destPort == 1001)}]"

