config *.deviceSource4.app[0].io.displayStringTextFormat "\"{numSent} Stream-(4)-(3)\""
config *.deviceSource*.app[0].source.packetLength "1000B - 46B"
config *.deviceSource1.app[0].source.productionInterval "truncnormal(400us, 25us)"
config *.deviceSource2.app[0].source.productionInterval "truncnormal(500us, 25us)"
